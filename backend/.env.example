# Application
APP_ENV=development
PORT=8000
DEBUG=False
# Log every SQL statement with parameters (emails, password hashes); keep off outside local debugging
SQL_ECHO=False
# JSON list of frontend origins allowed to call the API directly
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database
POSTGRES_USER=cfo_user
POSTGRES_PASSWORD=cfo_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cfo_db

# Async URL for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://cfo_user:cfo_password@localhost:5432/cfo_db

# Sync URL for Alembic (psycopg2)
SYNC_DATABASE_URL=postgresql+psycopg2://cfo_user:cfo_password@localhost:5432/cfo_db

# RHOAI / vLLM Model Endpoint (OpenShift AI)
# Local dev with port-forward: http://localhost:8080/v1 (or http://host.docker.internal:8080/v1 inside Docker)
# In-cluster on OpenShift: http://qwen3-8b-predictor.my-first-model.svc.cluster.local:8080/v1
MODEL_ENDPOINT_URL=http://localhost:8080/v1
MODEL_NAME=qwen3-8b
MODEL_API_KEY=

# Auth (JWT) - generate a real secret for any shared deployment, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=dev-only-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Empty = registration open only when APP_ENV=development; set False on a shared deployment
ALLOW_REGISTRATION=
# Local testing only: requests without a token act as the admin account. Refused unless APP_ENV=development.
AUTH_DISABLED=false

# Admin account created on API startup (local default admin / admin; set a strong password on a shared deployment, empty skips it)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Bank statement CSV used by `python -m app.services.seed` (empty = memory/reference/sample-data in the repo)
SEED_CSV_PATH=
