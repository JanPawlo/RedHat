# Application
APP_ENV=development
PORT=8000
DEBUG=True

# Database
POSTGRES_USER=cfo_user
POSTGRES_PASSWORD=cfo_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cfo_db

# Async URL for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://cfo_user:cfo_password@localhost:5432/cfo_db

# Sync URL for Alembic (psycopg2)
SYNC_DATABASE_URL=postgresql://cfo_user:cfo_password@localhost:5432/cfo_db

# RHOAI / vLLM Model Endpoint (OpenShift AI)
# Local dev with port-forward: http://localhost:8080/v1 (or http://host.docker.internal:8080/v1 inside Docker)
# In-cluster on OpenShift: http://llama-32-3b-instruct-predictor.my-first-model.svc.cluster.local:8080/v1
MODEL_ENDPOINT_URL=http://localhost:8080/v1
MODEL_NAME=llama-32-3b-instruct
MODEL_API_KEY=
